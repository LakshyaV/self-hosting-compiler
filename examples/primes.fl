// Sieve of Eratosthenes.

fn main() {
    let limit = 100;
    let composite = array_new(limit + 1, false);
    for i in 2..limit + 1 {
        if composite[i] { continue; }
        print(int_to_str(i));
        print(" ");
        let j = i * i;
        while j <= limit {
            composite[j] = true;
            j += i;
        }
    }
    println("");
}
