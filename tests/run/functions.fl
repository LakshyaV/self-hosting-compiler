// Functions: recursion, mutual recursion, six arguments, function values.

fn fib(n: int) -> int { if n < 2 { n } else { fib(n - 1) + fib(n - 2) } }

fn ack(m: int, n: int) -> int {
    if m == 0 { n + 1 }
    else if n == 0 { ack(m - 1, 1) }
    else { ack(m - 1, ack(m, n - 1)) }
}

fn is_even(n: int) -> bool { if n == 0 { true } else { is_odd(n - 1) } }
fn is_odd(n: int) -> bool { if n == 0 { false } else { is_even(n - 1) } }

fn six(a: int, b: int, c: int, d: int, e: int, f: int) -> int {
    a + 2 * b + 3 * c + 4 * d + 5 * e + 6 * f
}

fn gcd(a: int, b: int) -> int { if b == 0 { a } else { gcd(b, a % b) } }

fn double(x: int) -> int { x * 2 }
fn square(x: int) -> int { x * x }
fn apply(f: fn(int) -> int, x: int) -> int { f(x) }
fn twice(f: fn(int) -> int, x: int) -> int { f(f(x)) }

fn map_ints(f: fn(int) -> int, v: Vec<int>) -> Vec<int> {
    let out = vec_new();
    for i in 0..v.len { push(out, f(at(v, i))); }
    out
}

fn pick(which: bool) -> fn(int) -> int {
    if which { double } else { square }
}

fn fold(f: fn(int, int) -> int, v: Vec<int>, start: int) -> int {
    let acc = start;
    for i in 0..v.len { acc = f(acc, at(v, i)); }
    acc
}

fn add(a: int, b: int) -> int { a + b }

fn show(n: int) { println(int_to_str(n)); }

fn main() {
    show(fib(25));
    show(ack(2, 3));
    show(if is_even(10) { 1 } else { 0 });
    show(if is_odd(7) { 1 } else { 0 });
    show(six(1, 2, 3, 4, 5, 6));
    show(six(6, 5, 4, 3, 2, 1));
    show(gcd(1071, 462));
    show(apply(double, 21));
    show(twice(square, 3));
    let f = pick(true);
    let g = pick(false);
    show(f(10) + g(10));
    let v = vec_new();
    for i in 1..6 { push(v, i); }
    let w = map_ints(square, v);
    show(fold(add, w, 0));
    show(fold(max, v, -1));
    // arguments evaluated left to right
    let log = vec_new();
    show(six(note(log, 1), note(log, 2), note(log, 3), note(log, 4), note(log, 5), note(log, 6)));
    show(fold(add, log, 0) * 1000 + at(log, 0) * 10 + at(log, 5));
}

fn note(log: Vec<int>, n: int) -> int {
    push(log, n * (log.len + 1));
    n
}
