// Integer arithmetic: precedence, signed division, shifts, wrap-around.

fn show(label: string, n: int) {
    println(cat3(label, " = ", int_to_str(n)));
}

fn main() {
    show("1 + 2 * 3", 1 + 2 * 3);
    show("(1 + 2) * 3", (1 + 2) * 3);
    show("7 / 2", 7 / 2);
    show("-7 / 2", -7 / 2);
    show("7 / -2", 7 / -2);
    show("7 % 3", 7 % 3);
    show("-7 % 3", -7 % 3);
    show("7 % -3", 7 % -3);
    show("1 << 10", 1 << 10);
    show("-1024 >> 3", -1024 >> 3);
    show("0xFF & 0x0F", 0xFF & 0x0F);
    show("0xF0 | 0x0F", 0xF0 | 0x0F);
    show("0xFF ^ 0x0F", 0xFF ^ 0x0F);
    show("1 | 2 & 3", 1 | 2 & 3);
    show("1 + 2 << 3", 1 + 2 << 3);
    show("'a'", 'a');
    show("'\\n'", '\n');
    show("- - 5", - -5);
    // 64-bit wrap-around
    let big = 9223372036854775807;
    show("max", big);
    show("max + 1", big + 1);
    show("min - 1", (0 - big - 1) - 1);
    show("3000000000 * 4", 3000000000 * 4);
    show("big * 3", big * 3);
    show("1 << 63", 1 << 63);
    show("large literal", 0x7FFFFFFF + 1);
    show("needs imm64", 1234567890123 + 1);
    // the same with operands the optimiser cannot see through
    let v = vec_new();
    push(v, 7);
    push(v, -2);
    push(v, 40);
    let a = at(v, 0);
    let b = at(v, 1);
    let c = at(v, 2);
    show("a / b", a / b);
    show("a % b", a % b);
    show("a * b", a * b);
    show("a << 3", a << 3);
    show("b >> 1", b >> 1);
    show("a << a", a << a);
    show("1 << c", 1 << c);
    show("a * 8", a * 8);
    show("a * 10", a * 10);
    show("a * 1000000", a * 1000000);
    show("a - 5", a - 5);
    show("5 - a", 5 - a);
    show("a & 3", a & 3);
    show("a | 8", a | 8);
    show("a ^ a", a ^ a);
    show("a - b - c", a - b - c);
    show("a - (b - c)", a - (b - c));
    show("-a", -a);
    show("(a + b) * (a - b) / (c % a + 1)", (a + b) * (a - b) / (c % a + 1));
    show("a / a", a / a);
    show("c / a % 4", c / a % 4);
}
